    },
    {
      "step": 3,
      "name": "MoveToTargetArea",
      "location": "시나리오별 목표 구역",
      "description": "플레이어는 1인칭 시점으로 목표 구역까지 이동한다."
    },
    {
      "step": 4,
      "name": "NormalTask",
      "location": "시나리오별 목표 구역",
      "description": "겉으로는 평범한 야간 업무를 수행한다."
    },
    {
      "step": 5,
      "name": "AnomalyTrigger",
      "location": "시나리오별 목표 구역",
      "description": "전시물, 조명, 소리, 그림자, 반사, 기록 중 하나가 비정상적으로 반응한다."
    },
    {
      "step": 6,
      "name": "RuleBasedPlay",
      "location": "시나리오별 목표 구역",
      "description": "플레이어는 수첩 규칙을 해석하고 지키면서 목표를 완료한다."
    },
    {
      "step": 7,
      "name": "ReturnToGuardRoom",
      "location": "경비실",
      "description": "시나리오 목표 완료 후 반드시 경비실로 복귀한다."
    },
    {
      "step": 8,
      "name": "ScenarioComplete",
      "location": "경비실",
      "description": "경비실에서 완료 처리, 체크포인트 저장, 다음 시나리오 슬롯 대기 상태로 전환한다."
